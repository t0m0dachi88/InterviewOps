# ==============================================================================
# Execution Worker Service Environment Configuration
# ==============================================================================

NODE_ENV=development

# Upstash Redis Managed Cloud Instance (with TLS)
# Must connect to the same Upstash Redis instance as the API
WORKER_REDIS_HOST=your-database.upstash.io
WORKER_REDIS_PORT=6379
WORKER_REDIS_PASSWORD=your_upstash_password
WORKER_REDIS_TLS=true

# Alternative REDIS_URL format
# WORKER_REDIS_URL=rediss://default:your_upstash_password@your-database.upstash.io:6379

# Worker Concurrency limit for BullMQ
WORKER_CONCURRENCY=5

# MongoDB Atlas Managed Cloud Database (for reading submissions & writing execution results)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/technical_hiring_platform?retryWrites=true&w=majority

# Self-Hosted Judge0 Community Edition Execution Server
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
# Language ID overrides if customizing Judge0 language configurations:
JUDGE0_LANG_JS=63
JUDGE0_LANG_PYTHON=71
JUDGE0_LANG_CPP=54
